  "help_maintenance": "<blockquote><b>🔧 ᴍᴀɪɴᴛᴇɴᴀɴᴄᴇ</b></blockquote>\n\n{e_bullet} /maintenance\n{e_bullet} /maintenance enable\n{e_bullet} /maintenance disable",
